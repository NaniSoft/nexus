{
  "name": "@nanisoft/nexus",
  "version": "0.0.0",
  "private": true,
  "description": "nexus.nanisoft.com — Nexus, the Agent Factory: NaniSoft’s autonomous software-creation engine. Landing, full docs, and blog.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:docs-tree": "node scripts/check-docs-tree.mjs",
    "check:cascade": "node scripts/check-cascade.mjs",
    "check:prism-gates": "prism-gates",
    "check": "pnpm check:prism-gates && pnpm check:docs-tree"
  },
  "dependencies": {
    "@nanisoft/prism-ui": "0.13.0",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
